#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

board_config_update

board=$(board_name)

case "$board" in
zte,zxhn-f670l)
	ucidef_set_interface "lan" device "lan1 lan2 lan3" protocol "static" ipaddr "192.168.2.1"
	ucidef_set_interface "wan" device "lan4" protocol "dhcp"
	. /lib/functions/zte-paramtag.sh
	base=$(zte_paramtag_base_mac) && {
		ucidef_set_interface_macaddr "lan" "$base"
		ucidef_set_interface_macaddr "wan" "$(macaddr_add "$base" 3)"
	}
	;;
*)
	ucidef_set_interfaces_lan_wan "lan1 lan2 lan3 lan4" "wan"
	;;
esac

board_config_flush

exit 0
